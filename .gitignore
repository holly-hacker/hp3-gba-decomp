baserom*.gba
baserom.*.ss*
*.sav
gba_bios.*
build/
*.o
*.elf
result
result-*
# generated by tools/krawall/dump_krawall.py.
asm/krawall/
# Krawall music/sample content (tools/krawall/extract_krawall.py bootstraps this
# locally from the baserom) -- game's actual copyrighted audio content,
# not committed. See CLAUDE.md hard rule 2 and docs/formats/krawall.md.
data/audio/modules/*
data/audio/samples/*
!data/audio/modules/.gitkeep
!data/audio/samples/.gitkeep
# Dialog/UI text content (tools/text/extract_text.py bootstraps this locally
# from the baserom) -- game's actual copyrighted text content, not
# committed. See CLAUDE.md hard rule 2 and docs/formats/text.md.
data/text/*
!data/text/.gitkeep
# Folio Bruti monster stat data (tools/monsters/extract_monsters.py bootstraps
# this locally from the baserom) -- extracted game data, not committed.
# See CLAUDE.md hard rule 2 and docs/formats/folio_bruti.md.
data/monsters/*
!data/monsters/.gitkeep
# Object/spell behavior-script bytecode (tools/objscript/extract_objscript.py
# bootstraps this locally from the baserom) -- extracted game data, not
# committed. See CLAUDE.md hard rule 2 and docs/formats/object_script.md.
data/scripts/*
!data/scripts/.gitkeep
# Per-character level-up stat tables (tools/levels/extract_levels.py
# bootstraps this locally from the baserom) -- extracted game data, not
# committed. See CLAUDE.md hard rule 2 and docs/memory-map/battle.md.
data/levels/*
!data/levels/.gitkeep
# Battle item/equipment table (tools/items/extract_items.py bootstraps
# this locally from the baserom) -- extracted game data, not committed.
# See CLAUDE.md hard rule 2 and docs/formats/save.md.
data/items/*
!data/items/.gitkeep
# Item icon data (tools/items/extract_item_icons.py bootstraps this
# locally from the baserom) -- extracted game art, not committed. See
# CLAUDE.md hard rule 2 and docs/formats/graphics.md's "Item icons"
# section.
data/images/items/*
!data/images/items/.gitkeep
# Human-viewing dumps only (rendered PNGs, .xm exports, ...) -- never
# build input, always fully regeneratable, never committed. See
# `extract-item-icons`/`dump-music-xm` in the justfile.
extracted/
**/__pycache__
.claude/worktrees
# Regenerated by tools/c/gen_compile_commands.py -- points at the Nix store
# agbcc include path, which isn't stable across machines/rebuilds.
compile_commands.json
